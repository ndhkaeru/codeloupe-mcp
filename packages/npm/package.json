{
  "name": "@ndhkaeru/codeloupe-mcp",
  "version": "1.1.0",
  "description": "Local-first MCP server for code search, code intelligence, repository comparison, and safe file edits",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ndhkaeru/codeloupe-mcp.git"
  },
  "homepage": "https://github.com/ndhkaeru/codeloupe-mcp#readme",
  "bugs": {
    "url": "https://github.com/ndhkaeru/codeloupe-mcp/issues"
  },
  "type": "commonjs",
  "bin": {
    "codeloupe-mcp": "bin/codeloupe-mcp.js"
  },
  "files": [
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "optionalDependencies": {
    "@ndhkaeru/codeloupe-mcp-darwin-arm64": "1.1.0",
    "@ndhkaeru/codeloupe-mcp-darwin-x64": "1.1.0",
    "@ndhkaeru/codeloupe-mcp-linux-arm64": "1.1.0",
    "@ndhkaeru/codeloupe-mcp-linux-x64": "1.1.0",
    "@ndhkaeru/codeloupe-mcp-win32-arm64": "1.1.0",
    "@ndhkaeru/codeloupe-mcp-win32-x64": "1.1.0"
  },
  "scripts": {
    "prepare:native": "node scripts/prepare-npm-assets.js",
    "smoke": "node scripts/smoke.js",
    "test:env": "node scripts/test-env-aliases.js",
    "test:layout": "node scripts/test-package-layout.js && node scripts/test-launcher-resolution.js",
    "test:packed": "node scripts/test-packed-install.js"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "mcpName": "io.github.ndhkaeru/codeloupe-mcp"
}
